{
    "name": "semhoun/neuron-paradedb",
    "description": "ParadeDB vector and BM25 hybrid retrieval for Neuron AI",
    "type": "library",
    "license": "MIT",
    "require": {
        "php": "^8.1",
        "ext-pdo": "*",
        "ext-pdo_pgsql": "*",
        "neuron-core/neuron-ai": "^4.0"
    },
    "require-dev": {
        "friendsofphp/php-cs-fixer": "^3.75",
        "phpstan/phpstan": "^2.1",
        "phpunit/phpunit": "^10.5 || ^11.5 || ^12.0"
    },
    "autoload": {
        "psr-4": {"Semhoun\\NeuronParadeDB\\": "src/"}
    },
    "autoload-dev": {
        "psr-4": {"Semhoun\\NeuronParadeDB\\Tests\\": "tests/"}
    },
    "scripts": {
        "test": "phpunit --testsuite unit",
        "test:integration": "phpunit --testsuite integration",
        "analyse": "phpstan analyse --memory-limit=1G",
        "style": "php-cs-fixer fix",
        "style:check": "php-cs-fixer fix --dry-run --diff"
    },
    "config": {
        "sort-packages": true,
        "allow-plugins": {"php-http/discovery": true}
    }
}
